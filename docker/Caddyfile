# FrankenPHP config for the production image. TLS is terminated by the platform's proxy
# (Render), so the container serves plain HTTP on $PORT.
{
	admin off
	auto_https off
	frankenphp
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# Vite output has content hashes in its file names.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
